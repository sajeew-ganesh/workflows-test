        <mxCell id="G5Ap1sH_j5UwqjhmX80t-195" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Usage of Platform" vertex="1">
          <mxGeometry height="47" width="149" x="-22" y="1716" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-196" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="Bank&#39;s External Partner Systems (500+)" vertex="1">
          <mxGeometry height="46" width="280" x="130" y="1716" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-197" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Hosting &amp;amp; Operational Information" vertex="1">
          <mxGeometry height="161" width="149" x="413" y="1715" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-198" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding-left: 20px; padding-right: 2px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;Apigee Kubernetes based Application running from Datacenter&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;DC Site is Chandivali and DR site is&amp;nbsp; Bangalore&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;DC &amp;amp; DR are Active-Active with differential Load Handling at a given point in time&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;RHEL VMs are used as Master / Worker Nodes&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;10+ Namespaces are used to host the microservices&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="161" width="275" x="565" y="1715" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-199" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Application Usage" vertex="1">
          <mxGeometry height="29" width="149" x="413" y="1683" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-200" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="API Framework exposed to Consumers leverage Message Queues" vertex="1">
          <mxGeometry height="30" width="275" x="565" y="1683" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-201" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Application Rendered / Supported Business Services" vertex="1">
          <mxGeometry height="110" width="149" x="-22" y="1766" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-202" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;div&gt;API based invocation supports critical functionalities such as the following (but not limited to):&lt;/div&gt;&lt;ul style=&quot;padding-left: 30px;&quot;&gt;&lt;li&gt;Customer Login&lt;/li&gt;&lt;li&gt;OTP Invocation&lt;/li&gt;&lt;li&gt;Captcha / Challenge Prompting&lt;/li&gt;&lt;li&gt;Payment Transactions&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="130" y="1766" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-203" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Current Monitoring / Observability" vertex="1">
          <mxGeometry height="169" width="149" x="-22" y="1933" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-204" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul style=&quot;padding-left: 15px; padding-right: 5px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Apigee leverages&amp;nbsp;&lt;span data-teams=&quot;true&quot;&gt;Grafana and Kibana UI developed on top of &lt;/span&gt;Basic Free &amp;amp; Open ELK &amp;amp; AppD where the metrics of Container platform comes through fluentbit and logs are shipped using Filebeat.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Access Logs, native container logs along with customized app logs are shipped using filebeat and relayed into Elastic.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Basic Free &amp;amp; Open ELK and AppD provide observability / monitored dashboards currently&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169" width="278" x="130" y="1933" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-205" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Current Observability Challenges" vertex="1">
          <mxGeometry height="131" width="149" x="413" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-206" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding: 0px 5px 0px 20px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;ELK &amp;amp; AppD - multiple dashboards causing Fatigue to Operational Eyes&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;PR DR is Active-Active and need mechanism to observe the % Hosting from PR &amp;amp; DR&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Worker Node &amp;amp; POD health for Apigee Kubernetes&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Certificate expiration issues with partner and internal systems not identified early&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="131" width="275" x="565" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-207" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Existing Data Collection" vertex="1">
          <mxGeometry height="120" width="149" x="-22" y="2105" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-208" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="Apigee forms a smaller part of the whole10 TB Per day in their Basic Free &amp;amp; Open Elastic&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mapping is established for API calls that get routed to backend Product Processors with rate limiting information as well, which can be leveraged for BaaZ Observability&lt;/div&gt;" vertex="1">
          <mxGeometry height="119" width="278" x="130" y="2105" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-209" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Observability Fulfilment / Needs" vertex="1">
          <mxGeometry height="209" width="149" x="413" y="2015" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-210" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding: 0px 5px 0px 20px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); caret-color: rgb(0, 0, 0); white-space-collapse: preserve; background-color: initial;&quot;&gt;Promote business/channel-wise failures or health-concerns such as &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt; Ex. Payments, UPI, Statements&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Estabilish correlation between Consumer and Product processor (esp. for Errors)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Mechanism to identify ceritificate failures based on logs / api errors&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Top 10 errors analysis should be ML / Anomaly driven rather than static thresholds&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Critical event notification through email/teams&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Dimension based on Scope field&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;DNS, WAF, Router, LB level observability plus internal &amp;amp; external connectivity health for the APIs&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
