        <mxCell id="G5Ap1sH_j5UwqjhmX80t-136" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding: 0px 5px 0px 20px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); caret-color: rgb(0, 0, 0); white-space-collapse: preserve; background-color: initial;&quot;&gt;Promote business/channel-wise failures or health-concerns such as &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt; Ex. Payments, UPI, Statements&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Estabilish correlation between Consumers, Apigee and Product processors using Transaction ID, session IDs or as applicable&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Mechanism to identify ceritificate failures based on logs / api errors&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Top 10 errors analysis should be ML / Anomaly driven rather than static thresholds&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Critical event notification through email/teams&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex=