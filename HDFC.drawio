          <mxGeometry height="46" width="280" x="130" y="631" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Hosting &amp;amp; Operational Information" vertex="1">
          <mxGeometry height="161" width="149" x="413" y="630" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-122" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding-left: 20px; padding-right: 2px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;VM based Application&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;Active / Passive setup across DC &amp;amp; DR&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;DC Site is Chandivali and DR site is&amp;nbsp; Bangalore&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;DC &amp;amp; DR are Active-Active with differential Load Handling at a given point in time&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;Linux Based VMs are used for SOA&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;Application layer is served by Weblogic and API Gateway&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="161" width="275" x="565" y="630" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Application Usage" vertex="1">
          <mxGeometry height="29" width="149" x="413" y="598" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-124" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="API Framework exposed to Consumers leverage Message Queues" vertex="1">
          <mxGeometry height="30" width="275" x="565" y="598" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-125" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Application Rendered / Supported Business Services" vertex="1">
          <mxGeometry height="110" width="149" x="-22" y="681" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-126" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;div&gt;API based invocation supports critical functionalities such as the following (but not limited to):&lt;/div&gt;&lt;ul style=&quot;padding-left: 30px;&quot;&gt;&lt;li&gt;Customer Login&lt;/li&gt;&lt;li&gt;OTP Invocation&lt;/li&gt;&lt;li&gt;Captcha / Challenge Prompting&lt;/li&gt;&lt;li&gt;Payment Transactions&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="130" y="681" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-127" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Current Monitoring / Observability" vertex="1">
          <mxGeometry height="169" width="149" x="-22" y="848" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-128" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul style=&quot;padding-left: 15px; padding-right: 5px;&quot;&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;SOA leverages&amp;nbsp;&lt;span data-teams=&quot;true&quot;&gt;Grafana and Kibana UI developed on top of &lt;/span&gt;Basic Free &amp;amp; Open ELK &amp;amp; AppD where the metrics of Container platform comes through fluentbit and logs are shipped using Filebeat.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Access Logs, native container logs along with customized app logs are shipped using filebeat and relayed into Elastic.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Basic Free &amp;amp; Open ELK and AppD provide observability / monitored dashboards currently&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169" width="278" x="130" y="848" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-129" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Current Observability Challenges" vertex="1">
          <mxGeometry height="131" width="149" x="413" y="795" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-130" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=default;" value="&lt;ul style=&quot;padding: 0px 5px 0px 20px;&quot;&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;ELK &amp;amp; AppD - multiple dashboards causing Fatigue to Operational Eyes&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; face=&quot;Helvetica&quot;&gt;Current dashboards provide views of aggregate TPS / API Failures and not by Business / Channel-wise&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Surge in false alerts leading to Brain-drain and losing focus on real ones&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;caret-color: rgb(0, 0, 0); white-space-collapse: preserve;&quot;&gt;Certificate expiration issues with partner and internal systems not identified early&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="131" width="275" x="565" y="795" as="geometry" />
        </mxCell>
        <mxCell id="G5Ap1sH_j5UwqjhmX80t-131" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" value="Existing Data Collection" vertex="1">
